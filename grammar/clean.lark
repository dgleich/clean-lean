// Logical keywords and function are reserved expression words (case insensitive).
// Fragment input ends with one ignored ASCII space (the explicit EOF boundary).
?expression: equivalence
?equivalence: implication (IFF implication)* -> chain
?implication: disjunction (IMPLIES implication)? -> chain
?disjunction: conjunction (OR conjunction)* -> chain
?conjunction: negation (AND negation)* -> chain
?negation: NOT negation -> unary
         | comparison
?comparison: sum (COMPARE sum)* -> chain
?sum: product (ADD product)* -> chain
?product: signed (MULTIPLY signed)* -> chain
?signed: MINUS signed -> unary
       | power
?power: postfix (POWER signed)? -> chain
?postfix: atom postfix_suffix* -> postfix
postfix_suffix: "." ID -> field_suffix
              | "(" [arguments] ")" -> application_suffix
?atom: NUMBER -> decimal
     | name -> reference
     | "(" expression ")" -> group
     | "(" NUMBER ":" type_ref ")" -> numeral_annotation
     | TYPE_VALUE "(" type_ref ")" -> type_value
     | FUNCTION "(" ID ":" type_ref "," expression ")" -> function
     | FOR EVERY "(" ID ":" type_ref "," expression ")" -> universal
     | THERE EXISTS "(" ID ":" type_ref "," expression ")" -> existential
name: ID+
arguments: expression ("," expression)*
?type_ref: named_type_ref | computed_index | index_reference
named_type_ref: TYPE_ID ["(" [type_arguments | bound_type_arguments] ")"] -> type_ref
bound_type_arguments: TYPE_ID ":" type_ref "," type_ref
type_arguments: type_argument ("," type_argument)*
?type_argument: type_ref | NUMBER
computed_index: "(" expression ")"
index_reference: TYPE_ID ("." TYPE_ID)+
assumptions: assumption ("," assumption)*
assumption: [name ":"] expression
// Entry points used by the declaration interpreter. Opaque payloads are preserved.
header: DECL name "(" [parameters] ")" [":" type_text] ":"
parameters: parameter ("," parameter)*
parameter: ID [":" type_text]
source_header: "Source"i TYPE_ID ":"
scope_header: SCOPE title ":"
title: TITLE_WORD+
SCOPE: /(?i:Result|Theorem|Context)(?!\w)/
type_header: "Type"i TYPE_ID "(" [parameters] ")" ":"
structure_header: "Structure"i TYPE_ID "(" [parameters] ")" ":"
let_clause: LET identifiers ":" type_text -> typed_let
          | LET identifiers "be"i type_text -> typed_let
          | LET ID "=" expression -> value_let
          | DEFINE ID "=" expression -> value_let
identifiers: ID ("," ID)*
// Prose type phrases are resolved after parsing, using explicit module bindings.
type_text: type_piece+
?type_piece: TYPE_PART | "(" [type_text (("," | ":") type_text)*] ")"
import_line: "Import"i STRING -> clean_import
           | "Import"i "Lean"i MODULE -> lean_import
           | "Import"i "BibTeX"i STRING -> bib_import
default_numerals_line: _DEFAULT_WORD _NUMERALS_WORD ":" type_ref
_DEFAULT_WORD: /(?i:Default)(?!\w)/
_NUMERALS_WORD: /(?i:numerals)(?!\w)/
alias_line: "Alias"i TYPE_ID ":" TYPE_ID
phrase_line: "Phrase"i PHRASE "=>" OPAQUE
field: FIELD ":" OPAQUE
// Document blocks are recognized from lexical logical lines, after layout/continuation.
document: (_NL | top_level)*
?top_level: declaration | result | context | import_stmt | alias_stmt | phrase_stmt | default_numerals_stmt | prose | documented
prose: PROSE_LINE _NL
documented: DOC_LINE _NL (declaration | result)
documented_result: DOC_LINE _NL result
import_stmt: IMPORT_LINE _NL
alias_stmt: ALIAS_LINE _NL
phrase_stmt: PHRASE_LINE _NL
default_numerals_stmt: DEFAULT_NUMERALS_LINE _NL
declaration: HEADER_LINE _NL _INDENT declaration_field+ _DEDENT
?declaration_field: LET_LINE _NL -> declaration_let
                  | FIELD_LINE _NL -> declaration_field
                  | EXPR_FIELD_LINE _NL (_INDENT expression_line+ _DEDENT)? -> expression_field
expression_line: EXPR_LINE _NL
result: RESULT_LINE _NL _INDENT result_field* conclusion _DEDENT
?result_field: LET_LINE _NL -> result_let
             | ASSUME_LINE _NL -> result_assume
             | ATTRIBUTION_LINE _NL (_INDENT attribution_entry+ _DEDENT)? -> attribution
conclusion: CONCLUDE_LINE _NL (_INDENT expression_line+ _DEDENT)?
attribution_entry: FIELD_LINE _NL
context: CONTEXT_LINE _NL _INDENT (context_clause | prose)* (result | context | documented_result) (result | context | prose | documented_result)* _DEDENT
?context_clause: LET_LINE _NL -> context_let
               | ASSUME_LINE _NL -> context_assume
DECL: /(?i:Notation|Define|Condition)(?!\w)/
LET: /(?i:Let)(?!\w)/
DEFINE: /(?i:Define)(?!\w)/
FIELD: /(?i:Numerals|Prefix|Infix|Universe|Constructor|Means|From Lean|Returns|Equals|Holds when|Assumption name|Render latex|Render|Describe plural|Describe|Attribution|Kind|Label|Title|Author|Year|Version|Revision|Url|References|Source|Reference|Relationship|Scope|Changes|Note|Publisher|Declaration|Location)(?!\w)/
IFF: "↔"
IMPLIES: "→"
OR: /(?i:or)(?=\W)/ | "∨"
AND: /(?i:and)(?=\W)/ | "∧"
NOT: /(?i:not)(?=\W)/ | "¬"
TYPE_VALUE: /(?i:type)(?=\W)/
FUNCTION: /(?i:function)(?=\W)/
FOR: /(?i:for)(?=\W)/
EVERY: /(?i:every)(?=\W)/
THERE: /(?i:there)(?=\W)/
EXISTS: /(?i:exists)(?=\W)/
COMPARE: "=" | "≠" | "!=" | "<=" | ">=" | "≤" | "≥" | "<" | ">" | "∈" | "⊆" | "∣"
ADD: "+" | "-" | "∪" | "∩"
MINUS: "-"
MULTIPLY: "*" | "/"
POWER: "^"
ID: /(?!(?i:and|or|not|type|function|for|every|there|exists)\W)[^\W\d]\w*/
TYPE_ID: /[^\W\d]\w*/
TITLE_WORD: /\w+/
NUMBER: /\d+/
TYPE_PART: /[^(),:\s][^(),:\n]*/
STRING: /"[^"\n]+"/
MODULE: /[A-Za-z_][\w.]*/
PHRASE: /\S[^\n]*?(?=\s*=>)/
OPAQUE: /\S[^\n]*/
PROSE_LINE: /\uE000T[0-9]+/
DOC_LINE: /\uE000D[0-9]+/
IMPORT_LINE: /(?i:Import)[ ]+[^\n]+/
ALIAS_LINE: /(?i:Alias)[ ]+[^\n]+/
PHRASE_LINE: /(?i:Phrase)[ ]+[^\n]+/
DEFAULT_NUMERALS_LINE: /(?i:Default)[ ]+(?i:numerals)[ ]*:[^\n]*/
HEADER_LINE: /(?i:Structure|Notation|Condition|Type|Source)[ ]+[^\n]+|(?i:Define)[ ]+[^=\n]+/
RESULT_LINE: /(?i:Result|Theorem)[ ]+[^\n]+/
CONTEXT_LINE: /(?i:Context)[ ]+[^\n]+/
LET_LINE: /(?i:Let)[ ]+[^\n]+|(?i:Define)[ ]+[^ =\n]+[ ]*=[^\n]*/
ASSUME_LINE: /(?i:Assume)[ ]+[^\n]+/
ATTRIBUTION_LINE: /(?i:Attribution)[ ]*:[^\n]*/
CONCLUDE_LINE: /(?i:Conclude)(?!\w)[^\n]*/
EXPR_FIELD_LINE: /(?i:Equals|Holds when)[ ]*:[^\n]*/
FIELD_LINE: /(?i:Numerals|Prefix|Infix|Universe|Constructor|Means|From Lean|Returns|Assumption name|Render latex|Render|Describe plural|Describe|Attribution|Kind|Label|Title|Author|Year|Version|Revision|Url|References|Source|Reference|Relationship|Scope|Changes|Note|Publisher|Declaration|Location)[ ]*:[^\n]*/
EXPR_LINE: /\S[^\n]*/
_NL: /\n[ ]*/
%declare _INDENT _DEDENT
%ignore /[ \t]+/

