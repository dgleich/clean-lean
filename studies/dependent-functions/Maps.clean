Result graded associativity:
  Attribution: topology; graded map associativity; original
  Let K: Type
  Let field: FieldStructure(K)
  Let M,N,P,Q: GradedModule(K,field)
  Let f: GradedMap(K,field,M,N)
  Let g: GradedMap(K,field,N,P)
  Let h: GradedMap(K,field,P,Q)
  Conclude:
    graded composition(field,M,P,Q,graded composition(field,M,N,P,f,g),h) =
      graded composition(field,M,N,Q,f,graded composition(field,N,P,Q,g,h))

