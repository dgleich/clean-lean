private theorem support_exists (I : Type) (n a m : ℕ) (h : a+m ≤ n) (L : LABELS I n) (v : Fin (m+1)) :
 Nonempty (SUPPORT I n a m h L v) := by
 let survives : ∀ x : {i : I // i ∈ OLD I n a m h L v}, VALUE (OLD I n a m h L v) x ∈ SUR I n a m L := by
   intro x
   have hx := x.property
