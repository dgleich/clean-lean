+    from .syntax import expression_spelling
+    return ProofIndex('('+proof_spelling(expression.tree)+')',expression.lean,expression.tex,
+                      json.dumps(expression.tree,ensure_ascii=False),tuple(locals.items()),
+                      comparison=index_comparison(expression,env,locals))
