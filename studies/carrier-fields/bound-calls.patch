+# generated: gpt-6 2026-11-07 role=assisted; see PROVENANCE.md
+"""Internal module-call binding for checked computed indices."""
+from .core import CleanError
+
+
+class UnclosedBinding(CleanError):
+    """This prototype cannot preserve every binding in the given constructor."""
+
+
+def identity(env,name):
+    spec=env.data['functions'].get(name)
+    if spec is None:raise CleanError('Missing bound module callable: '+name)
+    return spec['lean']
+
+
+def bind(tree,env,locals):
+    kind=tree[0]
+    if kind=='ModuleCall':
+        if tree[3]!=identity(env,tree[1]):raise CleanError('Changed bound module callable: '+tree[1])
+        return [kind,tree[1],[bind(a,env,locals) for a in tree[2]],tree[3]]
+    if kind=='Call':
+        args=[bind(a,env,locals) for a in tree[2]]
+        if tree[1] in locals and env.is_function_type(locals[tree[1]].type):
+            return ['Apply',['Local',tree[1]],args]
+        return ['ModuleCall',tree[1],args,identity(env,tree[1])]
+    if kind=='Projection':return [kind,bind(tree[1],env,locals),tree[2]]
+    if kind=='Apply':return [kind,bind(tree[1],env,locals),[bind(a,env,locals) for a in tree[2]]]
+    if kind=='Operator':return [kind,tree[1],bind(tree[2],env,locals),bind(tree[3],env,locals)]
+    if kind=='Unary':return [kind,tree[1],bind(tree[2],env,locals)]
+    if kind=='TypeValue':
+        from .syntax import parse,type_tree
+        def has_call(node):
+            return isinstance(node,list) and (bool(node) and node[0] in ('Call','ModuleCall') or any(has_call(a) for a in node))
+        if has_call(type_tree(parse(tree[1],'type_ref'))):
+            raise UnclosedBinding('Bound callable prototype requires structural type annotations for nested calls')
+        return tree
+    if kind in ('Local','Decimal'):return tree
+    # Do not claim binding closure for source strings containing type expressions.
+    raise UnclosedBinding('Bound callable prototype does not close '+kind)
+
+
+def elaborate(tree,env,locals,arguments):
+    if tree[3]!=identity(env,tree[1]):raise CleanError('Changed bound module callable: '+tree[1])
+    result=env.call(tree[1],arguments,locals)
+    result.tree=['ModuleCall',tree[1],[a.tree for a in arguments],tree[3]]
+    return result
