-- Equation (1), for a finite real interpretation of one exact operation.
-- An IEEE bridge must prove this relation under its precise side conditions.
Condition single operation error(u,eta,exact,rounded):
  Let u,eta,exact,rounded: Real
  Holds when:
    there exists(delta: Real,there exists(epsilon: Real,
      rounded = exact*(1+delta)+epsilon and
      abs(delta) ≤ u and abs(epsilon) ≤ eta and delta*epsilon = 0))

Define forward error(exact: Real,rounded: Real): Real:
  Equals: abs(exact-rounded)

Notation list length(x):
  Let T: Type
  Let x: List(T)
  Returns: Natural
  Means: List.length x
  Render latex: \operatorname{{length}}({x})

Condition all entries(p,x):
  Let T: Type
  Let p: Function(T,Proposition)
  Let x: List(T)
  From Lean: List.Forall p x
  Render latex: \operatorname{{all}}({p},{x})

-- Forall2 requires matching lengths, not truncating zip semantics.
Condition corresponding entries(p,x,y):
  Let T,U: Type
  Let p: Function(T,Function(U,Proposition))
  Let x: List(T)
  Let y: List(U)
  From Lean: List.Forall₂ p x y
  Render latex: \operatorname{{corresponding}}({p},{x},{y})

Condition relative perturbation(bound,x,y):
  Let bound: Real
  Let x,y: List(Real)
  Holds when:
    corresponding entries(function(a: Real,function(b: Real,
      there exists(d: Real,b = a*(1+d) and abs(d) ≤ bound))),x,y)

Condition dot accuracy(u,eta,x,y,r):
  Let u,eta: Real
  Let x,y: List(Real)
  Let r: Real
  Holds when:
    list length(x) = list length(y) and
    there exists(perturbed: List(Real),there exists(c: Real,
      r = exact dot(perturbed,y)+c and
      relative perturbation(accumulated rounding(u,list length(x)),x,perturbed) and
      abs(c) ≤ accumulated underflow(u,eta,list length(x),list length(x))))

Condition sum accuracy(u,x,r):
  Let u: Real
  Let x: List(Real)
  Let r: Real
  Holds when:
    there exists(perturbed: List(Real),
      r = exact sum(perturbed) and
      relative perturbation(accumulated rounding(u,list length(x)-1),x,perturbed))

Define exact matrix vector(A: List(List(Real)),x: List(Real)): List(Real):
  Equals: matrix vector(function(a: Real,function(b: Real,a+b)),function(a: Real,function(b: Real,a*b)),0,A,x)

Condition entrywise matrix perturbation(bound,A,E):
  Let bound: Real
  Let A,E: List(List(Real))
  Holds when:
    corresponding entries(function(row: List(Real),function(error: List(Real),
      corresponding entries(function(a: Real,function(e: Real,abs(e) ≤ bound*abs(a))),row,error))),A,E)

Condition matrix vector accuracy(u,eta,A,x,r):
  Let u,eta: Real
  Let A: List(List(Real))
  Let x,r: List(Real)
  Holds when:
    all entries(function(row: List(Real),list length(row) = list length(x)),A) and
    there exists(E: List(List(Real)),there exists(residual: List(Real),
      list length(residual) = list length(A) and
      r = vector add(function(a: Real,function(b: Real,a+b)),
        exact matrix vector(matrix add(function(a: Real,function(b: Real,a+b)),A,E),x),residual) and
      entrywise matrix perturbation(accumulated rounding(u,list length(x)),A,E) and
      all entries(function(c: Real,abs(c) ≤ accumulated underflow(u,eta,list length(x),list length(x))),residual)))

Define safe entry bound(u: Real,eta: Real,e: Natural,n: Natural): Real:
  Equals:
    sqrt(((2^e-eta)/(1+u)-accumulated underflow(u,eta,n,n-1)) /
      (1+real index(n)*(1+u)^n))

Condition safe matrix vector input(u,eta,e,A,x):
  Let u,eta: Real
  Let e: Natural
  Let A: List(List(Real))
  Let x: List(Real)
  Holds when:
    accumulated underflow(u,eta,list length(x)+1,list length(x)) ≤ 2^e and
    all entries(function(row: List(Real),list length(row) = list length(x)),A) and
    all entries(function(a: Real,abs(a) ≤ safe entry bound(u,eta,e,list length(x))),x) and
    all entries(function(row: List(Real),
      all entries(function(a: Real,abs(a) ≤ safe entry bound(u,eta,e,list length(x))),row)),A)

-- Conservative forward condition derived from the stated g(n,n) mixed bound.
-- This does not silently repair equation (8)'s undefined two-argument h.
Condition dot forward accuracy(u,eta,x,y,r):
  Let u,eta: Real
  Let x,y: List(Real)
  Let r: Real
  Holds when:
    abs(r-exact dot(x,y)) ≤
      absolute product sum(x,y)*accumulated rounding(u,list length(x)) +
      accumulated underflow(u,eta,list length(x),list length(x))

