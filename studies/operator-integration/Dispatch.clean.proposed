Import Lean Mathlib.Data.Real.Basic

Type Type():
  Means: Type
  Render latex: Type
Type Proposition():
  Means: Prop
  Render latex: condition
Type Natural():
  Means: Nat
  Render latex: N
Type Real():
  Means: Real
  Render latex: R
Type Function(T: Type,U: Type):
  Means: (T) → (U)
  Render latex: {T}\to {U}
Type Vector(n: Natural,T: Type):
  Means: Fin n → T
  Render latex: {T}^{{{n}}}

Condition equal(x,y):
  Let T: Type
  Let x,y: T
  Infix: =
  From Lean: x=y
  Render latex: {x}={y}

Condition equal types(A: Type,B: Type):
  Infix: =
  From Lean: A=B
  Render latex: {A}={B}

Condition real equality(x: Real,y: Real):
  Infix: =
  From Lean: x=y
  Render latex: {x}={y}

-- These test-only ^ meanings exercise closed-sort eligibility, not exponentiation.
Notation choose first(x,y):
  Let T: Type
  Let x,y: T
  Returns: T
  Infix: ^
  Means: x
  Render latex: \operatorname{{choose}}({x},{y})

Notation choose carrier(A: Type,B: Type): Type:
  Infix: ^
  Means: A
  Render latex: \operatorname{{choose}}({A},{B})

Notation generic witness(x,h):
  Let T: Type
  Let x: T
  Let h: (x=x)
  Returns: T
  Infix: ^
  Means: x
  Render latex: \operatorname{{witness}}({x},{h})

Notation carrier witness(A: Type,h: (equal types(A,A))): Type:
  Infix: ^
  Means: A
  Render latex: \operatorname{{witness}}({A},{h})

Condition truth():
  From Lean: True
  Render latex: \mathrm{{True}}

-- The test-only prefix similarly probes a proof-sort candidate.
Notation generic marker(x):
  Let T: Type
  Let x: T
  Returns: T
  Prefix: -
  Means: x
  Render latex: \operatorname{{mark}}({x})

Notation proof marker(h: (truth())): (truth()):
  Prefix: -
  Means: h
  Render latex: \operatorname{{mark}}({h})

Notation sum(x: Natural,y: Natural): Natural:
  Infix: +
  Means: x+y
  Render latex: {x}+{y}

Notation vector sum(v,w):
  Let n: Natural
  Let v,w: Vector(n,Real)
  Returns: Vector(n,Real)
  Infix: +
  Means: v+w
  Render latex: {v}+{w}

Condition double natural(n: Natural,m: Natural):
  From Lean: m=n+n
  Render latex: {m}=2{n}

Condition double vector(n: Natural,v: Vector(n,Real),w: Vector(n,Real)):
  From Lean: w=v+v
  Render latex: {w}=2{v}

