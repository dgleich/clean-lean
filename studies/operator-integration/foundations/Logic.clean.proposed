Import Lean Mathlib.Logic.Basic

Type Type():
  Means: Type
  Render latex: \mathsf{{Type}}
  Describe: a type
  Describe plural: types
Type Proposition():
  Means: Prop
  Render latex: condition
  Describe: a condition
  Describe plural: conditions

Condition equal(x,y):
  Let T: Type
  Let x,y: T
  Infix: =
  From Lean: x=y
  Render latex: {x}={y}

Condition conjunction(p: Proposition,q: Proposition):
  Infix: and
  From Lean: p ∧ q
  Render: {p} and {q}

Condition implication(p: Proposition,q: Proposition):
  Infix: →
  Holds when: for every (h: (p), q)
  Render: {p} implies {q}

Condition negation(p: Proposition):
  Prefix: not
  From Lean: ¬p
  Render: not {p}

-- generated: 2026-10-23 role=assisted; LLM-authored portions; see PROVENANCE.md

Type Function(X: Type,Y: Type):
  Means: (X) → (Y)
  Render latex: {X}\to {Y}
  Describe: a function from ${X}$ to ${Y}$
  Describe plural: functions from ${X}$ to ${Y}$

Condition equivalent(p: Proposition,q: Proposition):
  Infix: ↔
  From Lean: p ↔ q
  Render: {p} if and only if {q}
