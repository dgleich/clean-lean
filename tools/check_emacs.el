;;; Run: emacs --batch -Q -l tools/check_emacs.el
(require 'ert)
(load (expand-file-name "../editors/emacs/clean-math-mode.el"
                        (file-name-directory load-file-name)) nil t)
(ert-deftest clean-math-structures ()
  (with-temp-buffer
    (insert "Structure Endpoints():\n  Constructor: endpoints\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min))
    (should (eq (get-text-property (point) 'face) 'font-lock-keyword-face))
    (search-forward "Constructor")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face))))
(ert-deftest clean-math-quantifiers ()
  (with-temp-buffer
    (insert "for every (x: Real, there exists (y: Real,x=y))")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min))
    (dolist (word '("for" "every" "there" "exists"))
      (search-forward word)
      (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face)))))
(ert-deftest clean-math-highlights ()
  (with-temp-buffer
    (insert "rEsUlT sample:\n  Let μ be Complex\n  Means: if p then x else y\n  -- Let z: Real\n")
    (clean-math-mode)
    (font-lock-ensure)
    (should-not indent-tabs-mode)
    (goto-char (point-min))
    (should (eq (get-text-property (point) 'face) 'font-lock-keyword-face))
    (search-forward "Complex")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-type-face))
    (search-forward "then")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-preprocessor-face))
    (search-forward "Let z")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))))
(ert-deftest clean-math-compact-signature ()
  (with-temp-buffer
    (insert "Notation cos(x: Real): Real:")
    (clean-math-mode)
    (font-lock-ensure)
    (goto-char (point-min))
    (search-forward "Real")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-type-face))))
(ert-deftest clean-math-comments ()
  (with-temp-buffer
    (insert "Let x: Real -- note\n/-\nignored\n-/\nMeans: #[1]\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "note")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))
    (search-forward "ignored")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))))
(ert-deftest clean-math-inline-comments ()
  (with-temp-buffer
    (insert "Let x: /- outer /- inner -/ tail -/ Real -- end\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "inner")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))
    (search-forward "Real")
    (should-not (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))
    (search-forward "end")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-comment-face))))
(ert-deftest clean-math-literate-text ()
  (with-temp-buffer
    (insert "Text latex:\n  -- prose\n\"\"\"latex\n/- prose\n\"\"\"\n/-- Attached documentation. -/\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "-- prose")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-string-face))
    (search-forward "/- prose")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-string-face))
    (search-forward "documentation")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-doc-face))))
(ert-deftest clean-math-dependent-function-type ()
  (with-temp-buffer
    (insert "Let f: Function(n: Natural,Vector(n,Real))\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "Function")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-type-face))))
(ert-deftest clean-math-prototype-block-and-literal ()
  (with-temp-buffer
    (insert "  aSsUmE zero contents:\n    v = (0: Vector(V.size,Complex))\n  lItErAl: 0\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "aSsUmE")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face))
    (search-forward "zero contents")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-variable-name-face))
    (search-forward "(0")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-constant-face))
    (search-forward "lItErAl")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face))))
(ert-deftest clean-math-classifier-metadata ()
  (with-temp-buffer
    (insert "  cLaSsIfIeS: 1\n")
    (clean-math-mode) (font-lock-ensure)
    (goto-char (point-min)) (search-forward "cLaSsIfIeS")
    (should (eq (get-text-property (1- (point)) 'face) 'font-lock-keyword-face))))
(ert-run-tests-batch-and-exit)

