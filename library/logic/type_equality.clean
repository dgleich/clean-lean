Import "../operators.clean"

/-! Equality between Type-0 carriers. This is a specific declared overload,
    not universe-polymorphic equality on arbitrary values. -/
Condition equal carriers(A: Type,B: Type):
  Infix: =
  From Lean: A = B
  Render latex: {A}={B}

Condition unequal carriers(A: Type,B: Type):
  Infix: ≠
  From Lean: A ≠ B
  Render latex: {A}\ne {B}

