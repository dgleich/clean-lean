Import "evidence.clean"
Import "../topology/basic.clean"

Notation equality congruence(f,x,y,h):
  Let X,Y: Type
  Let f: Function(X,Y)
  Let x,y: X
  Let h: Evidence((x = y))
  Returns: Evidence((f(x) = f(y)))
  Means: congrArg f h
  Render latex: \operatorname{{congrArg}}({f},{h})

Notation equality reflexivity(x):
  Let X: Type
  Let x: X
  Returns: Evidence((x = x))
  Means: Eq.refl x
  Render latex: \operatorname{{refl}}_{{{x}}}

