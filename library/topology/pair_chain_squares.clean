Define ambient chain map(field,H,X,Q):
  Let K: Type
  Let field: FieldStructure(K)
  Let H: HomologyTheory(K,field)
  Let X: TopologicalSpace
  Let Q: PairInclusion(X)
  Returns: ChainMap(K,field,(singular chains(field,H,subspace(X,Q.source.ambient))),(singular chains(field,H,subspace(X,Q.target.ambient))))
  Equals:
    induced chain map(field,H,subspace(X,Q.source.ambient),subspace(X,Q.target.ambient),ambient continuous map(X,Q))
  Render latex: C_*({Q}.ambient)

Define relative subset chain map(field,H,X,Q):
  Let K: Type
  Let field: FieldStructure(K)
  Let H: HomologyTheory(K,field)
  Let X: TopologicalSpace
  Let Q: PairInclusion(X)
  Returns: ChainMap(K,field,(singular chains(field,H,subspace(X,Q.source.relative))),(singular chains(field,H,subspace(X,Q.target.relative))))
  Equals:
    induced chain map(field,H,subspace(X,Q.source.relative),subspace(X,Q.target.relative),relative continuous map(X,Q))
  Render latex: C_*({Q}.relative)

Condition square represents pair inclusion(field,H,X,Q,S):
  Let K: Type
  Let field: FieldStructure(K)
  Let H: HomologyTheory(K,field)
  Let X: TopologicalSpace
  Let Q: PairInclusion(X)
  Let S: PairChainSquare(K,field,H,X,Q)
