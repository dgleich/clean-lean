Type HomologyClass(K: Type, field: FieldStructure(K), H: HomologyTheory(K,field), X: TopologicalSpace):
  Equals: ModuleElement(K,field,(homology module(field,H,X)))

Notation homology linear map(field,H,X,Y,g):
  Let K: Type
  Let field: FieldStructure(K)
  Let H: HomologyTheory(K,field)
  Let X,Y: TopologicalSpace
  Let g: ContinuousMap(X,Y)
  Returns: ModuleMap(K,field,(homology module(field,H,X)),(homology module(field,H,Y)))
  Means: (letI : Field K := field; ((AlgebraicTopology.singularHomologyFunctor (ModuleCat.{0} K) H.degree).obj H.coefficients).map (TopCat.ofHom g))
  Render latex: {{{g}}}_*

Define induced homology value(field,H,X,Y,g,x):
  Let K: Type
