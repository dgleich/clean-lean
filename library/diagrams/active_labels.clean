Define active label equivalence(I,n,a,m,h,L,v,support,left,right):
  Let I: Type
  Let n,a,m: Natural
  Let h: Evidence((a+m ≤ n))
  Let L: IntervalLabels(I,n)
  Let v: Vertex((m+1))
  Let support: ActiveLabelSupport(I,n,a,m,h,L,v)
  Let left: Function(x: OriginalActiveLabels(I,n,a,m,h,L,v),
    Evidence((restore active label(I,n,a,m,h,L,v,support,
      restrict active label(I,n,a,m,h,L,v,support,x)) = x)))
  Let right: Function(y: RestrictedActiveLabels(I,n,a,m,L,v),
    Evidence((restrict active label(I,n,a,m,h,L,v,support,
      restore active label(I,n,a,m,h,L,v,support,y)) = y)))
  Returns: Equivalence(OriginalActiveLabels(I,n,a,m,h,L,v),RestrictedActiveLabels(I,n,a,m,L,v))
  Equals: equivalence(type(OriginalActiveLabels(I,n,a,m,h,L,v)),
    type(RestrictedActiveLabels(I,n,a,m,L,v)),
    function(x: OriginalActiveLabels(I,n,a,m,h,L,v),restrict active label(I,n,a,m,h,L,v,support,x)),
    function(y: RestrictedActiveLabels(I,n,a,m,L,v),restore active label(I,n,a,m,h,L,v,support,y)),
