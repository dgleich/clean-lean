Import "interval_clipping.clean"

Define original active labels(I,n,a,m,h,L,v):
  Let I: Type
  Let n,a,m: Natural
  Let h: Evidence((a+m ≤ n))
  Let L: IntervalLabels(I,n)
  Let v: Vertex((m+1))
  Returns: Set(I)
  Equals: interval labels at(I,n,L,subpath vertex(n,a,m,h,v))
  Render latex: A({L},{a}+{v})

Define restricted active labels(I,n,a,m,L,v):
  Let I: Type
  Let n,a,m: Natural
  Let L: IntervalLabels(I,n)
  Let v: Vertex((m+1))
  Returns: Set(Element(I,(surviving interval labels(I,n,a,m,L))))
  Equals: interval labels at(type(Element(I,(surviving interval labels(I,n,a,m,L)))),m,
    restricted interval labels(I,n,a,m,L),v)
  Render latex: R({L},{v})

Type OriginalActiveLabels(I: Type,n: Natural,a: Natural,m: Natural,h: Evidence((a+m ≤ n)),L: IntervalLabels(I,n),v: Vertex((m+1))):
  Equals: Element(I,(original active labels(I,n,a,m,h,L,v)))

Type RestrictedActiveLabels(I: Type,n: Natural,a: Natural,m: Natural,L: IntervalLabels(I,n),v: Vertex((m+1))):
