Import "interval_bases.clean"
Import "subpaths.clean"

Notation natural minimum(a,b):
  Let a,b: Natural
  Returns: Natural
  Means: min a b
  Render latex: \min({a},{b})

Notation minimum left bound(a,b):
  Let a,b: Natural
  Returns: Evidence((natural minimum(a,b) ≤ a))
  Means: Nat.min_le_left a b
  Render latex: \operatorname{{minBound}}

Notation bounded vertex(n,k,h):
  Let n,k: Natural
  Let h: Evidence((k ≤ n))
  Returns: Vertex((n+1))
  Means: Fin.mk k (Nat.lt_succ_of_le h)
  Render latex: {k}

Define clipped vertex(n,a,m,v):
  Let n,a,m: Natural
  Let v: Vertex((n+1))
  Returns: Vertex((m+1))
  Equals: bounded vertex(m,natural minimum(m,vertex number(n+1,v)-a),
    minimum left bound(m,vertex number(n+1,v)-a))
  Render latex: c_{{{a},{m}}}({v})

Define surviving interval labels(I,n,a,m,L):
  Let I: Type
  Let n,a,m: Natural
  Let L: IntervalLabels(I,n)
  Returns: Set(I)
  Equals: set of(function(i: I,
    vertex number(n+1,L.lower(i)) ≤ a+m and
      a ≤ vertex number(n+1,L.upper(i))))
  Render latex: {L}|_{{[{a},{a}+{m}]}}

Notation vertex order numbers(n,u,v,h):
  Let n: Natural
  Let u,v: Vertex(n)
  Let h: Evidence((u ≤ v))
  Returns: Evidence((vertex number(n,u) ≤ vertex number(n,v)))
  Means: h
  Render latex: {h}

Notation subtraction preserves order(a,u,v,h):
  Let a,u,v: Natural
  Let h: Evidence((u ≤ v))
  Returns: Evidence((u-a ≤ v-a))
  Means: Nat.sub_le_sub_right h a
  Render latex: {h}

Notation minimum preserves order(m,u,v,h):
  Let m,u,v: Natural
  Let h: Evidence((u ≤ v))
  Returns: Evidence((natural minimum(m,u) ≤ natural minimum(m,v)))
  Means: min_le_min_left m h
  Render latex: {h}

Notation bounded vertices ordered(n,k,l,hk,hl,h):
  Let n,k,l: Natural
  Let hk: Evidence((k ≤ n))
  Let hl: Evidence((l ≤ n))
  Let h: Evidence((k ≤ l))
  Returns: Evidence((bounded vertex(n,k,hk) ≤ bounded vertex(n,l,hl)))
  Means: h
  Render latex: {h}

Define clipped vertices ordered(n,a,m,u,v,h):
  Let n,a,m: Natural
  Let u,v: Vertex((n+1))
  Let h: Evidence((u ≤ v))
  Returns: Evidence((clipped vertex(n,a,m,u) ≤ clipped vertex(n,a,m,v)))
  Equals: bounded vertices ordered(m,
    natural minimum(m,vertex number(n+1,u)-a),
    natural minimum(m,vertex number(n+1,v)-a),
    minimum left bound(m,vertex number(n+1,u)-a),
    minimum left bound(m,vertex number(n+1,v)-a),
    minimum preserves order(m,vertex number(n+1,u)-a,vertex number(n+1,v)-a,
      subtraction preserves order(a,vertex number(n+1,u),vertex number(n+1,v),
        vertex order numbers(n+1,u,v,h))))
  Render latex: {h}

Define restricted interval labels(I,n,a,m,L):
  Let I: Type
  Let n,a,m: Natural
  Let L: IntervalLabels(I,n)
  Returns: IntervalLabels(Element(I,(surviving interval labels(I,n,a,m,L))),m)
  Equals: interval labels(type(Element(I,(surviving interval labels(I,n,a,m,L)))),m,
    function(j: Element(I,(surviving interval labels(I,n,a,m,L))),
      clipped vertex(n,a,m,L.lower(selected value(surviving interval labels(I,n,a,m,L),j)))),
    function(j: Element(I,(surviving interval labels(I,n,a,m,L))),
      clipped vertex(n,a,m,L.upper(selected value(surviving interval labels(I,n,a,m,L),j)))),
    function(j: Element(I,(surviving interval labels(I,n,a,m,L))),
      clipped vertices ordered(n,a,m,
        L.lower(selected value(surviving interval labels(I,n,a,m,L),j)),
        L.upper(selected value(surviving interval labels(I,n,a,m,L),j)),
        L.ordered(selected value(surviving interval labels(I,n,a,m,L),j)))))
  Render latex: {L}|_{{[{a},{a}+{m}]}}

