Import "module_spaces.clean"

Notation module subspace infimum(field,M,spaces):
  Let K: Type
  Let field: FieldStructure(K)
  Let M: CoefficientModule(K,field)
  Let spaces: Set(ModuleSubspace(K,field,M))
  Returns: ModuleSubspace(K,field,M)
  Means: (letI : Field K := field; sInf spaces)
  Render latex: \bigcap {spaces}

Define intersection of module family(field,M,spaces):
  Let K,I: Type
  Let field: FieldStructure(K)
  Let M: CoefficientModule(K,field)
  Let spaces: Function(I,ModuleSubspace(K,field,M))
  Returns: ModuleSubspace(K,field,M)
  Equals:
    module subspace infimum(field,M,
      set of(function(U: ModuleSubspace(K,field,M),
        there exists (i: I,U = spaces(i)))))
  Render latex: \bigcap_i {spaces}(i)

