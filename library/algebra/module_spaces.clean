-- generated: gpt-6 2026-11-06 role=assisted; see PROVENANCE.md
Import "linear_spaces.clean"
Import Lean Mathlib.Algebra.Category.ModuleCat.Basic

Type CoefficientModule(K: Type, field: FieldStructure(K)):
  Universe: 1
  Means: (@ModuleCat.{0,0} K field.toRing)
  Render latex: \operatorname{{Mod}}_{{{K}}}
  Describe: a module over ${K}$

Type ModuleElement(K: Type, field: FieldStructure(K), M: CoefficientModule(K,field)):
  Means: (@ModuleCat.carrier K field.toRing M)
  Render latex: {M}
  Describe: an element of ${M}$

Notation coefficient module(K,field,V,L):
  Let K: Type
  Let field: FieldStructure(K)
  Let V: Type
  Let L: LinearSpace(K,field,V)
  Returns: CoefficientModule(K,field)
  Means: @ModuleCat.of K field.toRing V L.addition L.action
  Render latex: {V}

-- generated: 2026-10-23 role=assisted; LLM-authored portions; see PROVENANCE.md

Type ModuleMap(K: Type, field: FieldStructure(K), M: CoefficientModule(K,field), N: CoefficientModule(K,field)):
  Means: (@ModuleCat.Hom K field.toRing M N)
  Render latex: \operatorname{{Hom}}_{{{K}}}({M},{N})
  Describe: a linear map from ${M}$ to ${N}$

Type ModuleSubspace(K: Type, field: FieldStructure(K), M: CoefficientModule(K,field)):
  Means: (@Submodule K M.carrier field.toSemiring M.isAddCommGroup.toAddCommMonoid M.isModule)
  Render latex: \operatorname{{Subspace}}({M})
  Describe: a subspace of ${M}$

Notation module map value(field,M,N,f,x):
  Let K: Type
  Let field: FieldStructure(K)
  Let M,N: CoefficientModule(K,field)
  Let f: ModuleMap(K,field,M,N)
  Let x: ModuleElement(K,field,M)
  Returns: ModuleElement(K,field,N)
  Means: (@ModuleCat.Hom.hom K field.toRing M N f) x
  Render latex: {f}({x})

Notation module map range(field,M,N,f):
  Let K: Type
  Let field: FieldStructure(K)
  Let M,N: CoefficientModule(K,field)
  Let f: ModuleMap(K,field,M,N)
  Returns: ModuleSubspace(K,field,N)
  Means: LinearMap.range (@ModuleCat.Hom.hom K field.toRing M N f)
  Render latex: \operatorname{{range}}({f})

Notation module subspace carrier(field,M,U):
  Let K: Type
  Let field: FieldStructure(K)
  Let M: CoefficientModule(K,field)
  Let U: ModuleSubspace(K,field,M)
  Returns: Set(ModuleElement(K,field,M))
  Means: U.carrier
  Render latex: {U}

Condition belongs to module subspace(field,M,x,U):
  Let K: Type
  Let field: FieldStructure(K)
  Let M: CoefficientModule(K,field)
  Let x: ModuleElement(K,field,M)
  Let U: ModuleSubspace(K,field,M)
  Holds when: x ∈ module subspace carrier(field,M,U)
  Render: {x} belongs to {U}
